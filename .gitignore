# ── Build output ───────────────────────────────────────────────────────────
/target/
**/target/
/artifacts/
/logs/
*.o
*.rlib
*.rmeta

# ── Disk images and firmware (large, regenerated by the build) ──────────────
# disk.img is ~1.3 GiB and rebuilt by `cargo run -p tools -- build-fs`.
/disk.img
*.img
/OVFMD_CODE.fd
/OVMF_CODE.fd
/OVMF_VARS.fd
*.fd

# ── ESP build outputs ───────────────────────────────────────────────────────
# The FAT ESP is assembled by the build. Its layout is committed, but the
# staged kernel/initrd/compositor binaries are not.
/esp/efi/boot/initrd.tar
/esp/efi/boot/kernel
/esp/efi/boot/kernel.elf
/esp/efi/boot/mywima
/esp/efi/boot/mywima.elf
/esp/NvVars

# ── Vendored third-party source fetched by the build ────────────────────────
# Downloaded/built by scripts/build-fs.sh, not maintained here.
/busybox-*/
/bash-*.tar.gz
/doomgeneric/
/disk_folders/
/disk_usr_lib/
/vendor/

